VITE_API_MODE=mock
VITE_MOCK_API_BASE_URL=http://localhost:3001
TASKFLOW_DEV_PORT=5173

# Used by the local Vite proxy only; this is not exposed as import.meta.env.
TASKFLOW_BACKEND_URL=https://task-flow-six-rouge.vercel.app

# Auth.js must receive a callback URL trusted by the TaskFlow host.
VITE_TASKFLOW_CALLBACK_URL=https://task-flow-six-rouge.vercel.app/
